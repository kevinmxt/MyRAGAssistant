{
  "llm": {
    "apiKey": "",
    "baseUrl": "https://api.deepseek.com",
    "modelName": "deepseek-v4-flash",
    "systemPrompt": "你是一个基于本地知识库的智能助手，请根据提供的文档内容回答用户问题。如果文档中没有相关信息，请如实告知。",
    "temperature": 0.7,
    "maxTokens": 4096,
    "timeoutSeconds": 120
  },
  "retrieval": {
    "maxResults": 3,
    "minScore": 0.5
  },
  "document": {
    "dir": "./documents",
    "chunkSize": 300,
    "chunkOverlap": 0,
    "supportedExtensions": [".txt", ".pdf", ".docx", ".doc", ".png", ".jpg", ".jpeg", ".md", ".html", ".csv", ".json", ".xlsx", ".pptx"]
  },
  "chat": {
    "memorySize": 10
  },
  "server": {
    "port": 8080
  },
  "milvus": {
    "host": "localhost",
    "port": 19530,
    "collectionName": "rag_knowledge_base",
    "dimension": 512,
    "consistencyLevel": "STRONG"
  },
  "queryEnhancement": {
    "enabled": true,
    "defaultMode": "auto",
    "rrfK": 60,
    "hydeMaxTokens": 200
  },
  "multiRecall": {
    "enabled": false,
    "modes": ["dense"],
    "rrfK": 60,
    "topK": 5,
    "lightrag": {
      "pythonPath": "python",
      "workingDir": "data/kg",
      "embeddingModelPath": "models/bge-small-zh-v1.5",
      "queryMode": "hybrid"
    }
  },
  "rerank": {
    "modelPath": "models/bge-reranker-v2-m3",
    "expansionFactor": 3,
    "topK": 5,
    "autoDownload": true,
    "downloadMirror": "https://hf-mirror.com"
  },
  "evaluation": {
    "topK": 5,
    "formats": ["markdown", "txt", "pdf", "docx", "json"],
    "answerQualityEnabled": true,
    "degradationThreshold": 0.05
  }
}
