{
  "app": {
    "name": "MyAIDemo2",
    "version": "1.3.0",
    "port": 8080
  },
  "llm": {
    "baseUrl": "http://localhost:11434/v1",
    "modelName": "qwen2.5:7b",
    "temperature": 0.1,
    "maxTokens": 2048,
    "timeout": 60
  },
  "embedding": {
    "modelPath": "models/bge-small-zh-v1.5",
    "dimension": 512,
    "maxTokensPerChunk": 512
  },
  "milvus": {
    "host": "localhost",
    "port": 19530,
    "database": "default",
    "collectionName": "knowledge_base"
  },
  "chunking": {
    "strategy": "adaptive",
    "maxChunkSize": 512,
    "overlap": 64,
    "minChunkSize": 128,
    "separators": ["\n\n", "\n", "。", ".", " "]
  },
  "retrieval": {
    "topK": 5,
    "recallTimeout": 30,
    "enableMultiRecall": true,
    "enableQueryEnhancement": true,
    "enableRerank": true,
    "rerankTopK": 10
  },
  "rerank": {
    "modelPath": "models/bge-reranker-v2-m3",
    "topK": 5,
    "autoDownload": true
  },
  "evaluation": {
    "topK": 5,
    "formats": ["markdown", "txt", "pdf", "docx", "json"],
    "answerQualityEnabled": true,
    "degradationThreshold": 0.05
  },
  "knowledgeGraph": {
    "enabled": true,
    "provider": "lightrag",
    "pythonPath": "python",
    "workingDir": "lightrag_data"
  }
}
